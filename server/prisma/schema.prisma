generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                                         String            @id @default(uuid())
  email                                      String            @unique
  passwordHash                               String            @map("password_hash")
  role                                       String            @default("USER")
  status                                     String            @default("ACTIVE")
  createdAt                                  DateTime          @default(now()) @map("created_at")
  updatedAt                                  DateTime          @updatedAt @map("updated_at")
  addresses                                  Address[]
  comments                                   Comment[]
  favorites                                  Favorite[]
  questions                                  ItemQuestion[]
  item_reviews                               item_reviews[]
  items                                      Item[]
  messages                                   Message[]
  notifications                              Notification[]
  profile                                    Profile?
  supportRequests                            SupportRequest[]
  receivedTrades                             Trade[]           @relation("ReceivedTrades")
  sentTrades                                 Trade[]           @relation("SentTrades")
  interactions                               UserInteraction[]
  user_reviews_user_reviews_author_idTousers user_reviews[]    @relation("user_reviews_author_idTousers")
  user_reviews_user_reviews_user_idTousers   user_reviews[]    @relation("user_reviews_user_idTousers")
  chatRooms                                  ChatRoom[]        @relation("ChatRoomToUser")

  @@map("users")
}

model Profile {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  city             String?
  country          String?   @default("Turkey")
  bio              String?
  avatarUrl        String?   @map("avatar_url")
  rating           Float     @default(0.0)
  totalTrades      Int       @default(0) @map("total_trades")
  score            Int       @default(0)
  swapsCompleted   Int       @default(0) @map("swaps_completed")
  cancellationRate Float     @default(0.0) @map("cancellation_rate")
  medal            String?
  isPremium        Boolean   @default(false) @map("is_premium")
  premiumUntil     DateTime? @map("premium_until")
  latitude         Float?    @map("latitude")
  longitude        Float?    @map("longitude")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  address   String
  type      String   @default("HOME")
  city      String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?    @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  items       Item[]

  @@map("categories")
}

model Item {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  categoryId       String            @map("category_id")
  title            String
  description      String
  condition        String
  status           String            @default("DRAFT")
  location         String?
  estimatedValue   Float?            @map("estimated_value")
  swapFor          String?           @map("swap_for")
  tags             String?
  wantedCategories String?           @map("wanted_categories")
  latitude         Float?            @map("latitude")
  longitude        Float?            @map("longitude")
  tag              String?
  isFeatured       Boolean           @default(false) @map("is_featured")
  isPopular        Boolean           @default(false) @map("is_popular")
  viewCount        Int               @default(0) @map("view_count")
  favoriteCount    Int               @default(0) @map("favorite_count")
  messageCount     Int               @default(0) @map("message_count")
  qualityScore     Float             @default(0.0) @map("quality_score")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  comments         Comment[]
  favorites        Favorite[]
  images           ItemImage[]
  questions        ItemQuestion[]
  item_reviews     item_reviews[]
  category         Category          @relation(fields: [categoryId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeItems       TradeItem[]
  interactions     UserInteraction[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([estimatedValue])
  @@index([isFeatured])
  @@index([isPopular])
  @@map("items")
}

model ItemImage {
  id           String   @id @default(uuid())
  itemId       String   @map("item_id")
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_images")
}

model ItemQuestion {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  question  String
  answer    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([userId])
  @@index([itemId, createdAt])
  @@map("item_questions")
}

model Trade {
  id         String      @id @default(uuid())
  senderId   String      @map("sender_id")
  receiverId String      @map("receiver_id")
  status     String      @default("PENDING")
  message    String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  tradeItems TradeItem[]
  receiver   User        @relation("ReceivedTrades", fields: [receiverId], references: [id])
  sender     User        @relation("SentTrades", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("trades")
}

model TradeItem {
  id        String   @id @default(uuid())
  tradeId   String   @map("trade_id")
  itemId    String   @map("item_id")
  side      String
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id])
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, itemId])
  @@index([tradeId])
  @@index([itemId])
  @@map("trade_items")
}

model ChatRoom {
  id        String    @id @default(uuid())
  userIds   String    @map("user_ids")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]
  users     User[]    @relation("ChatRoomToUser")

  @@map("chat_rooms")
}

model Message {
  id         String   @id @default(uuid())
  chatRoomId String   @map("chat_room_id")
  senderId   String   @map("sender_id")
  content    String
  type       String   @default("TEXT")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId])
  @@index([senderId])
  @@map("messages")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
  @@map("favorites")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model HelpCategory {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("HelpCircle")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("help_categories")
}

model PremiumPerk {
  id          String   @id @default(uuid())
  title       String
  value       String?
  description String
  icon        String   @default("Sparkles")
  color       String   @default("text-amber-500")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("premium_perks")
}

model PremiumPlan {
  id          String   @id @default(uuid())
  name        String
  price       Float
  period      String   @default("MONTHLY")
  description String?
  features    String
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("premium_plans")
}

model SafeSwapStep {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("Shield")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("safe_swap_steps")
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  group       String   @default("general")
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("site_settings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @default("SYSTEM")
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model UserInteraction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  type      String
  weight    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemId])
  @@index([userId, createdAt])
  @@map("user_interactions")
}

model Comment {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([userId])
  @@index([itemId, createdAt])
  @@map("comments")
}

model SupportRequest {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("support_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item_reviews {
  id         String    @id @default(uuid())
  author_id  String
  item_id    String
  score      Int
  comment    String?
  created_at DateTime? @default(now())
  users      User      @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items      Item      @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([author_id, item_id])
  @@index([author_id], map: "idx_item_reviews_author_id")
  @@index([item_id], map: "idx_item_reviews_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_reviews {
  id                                  String    @id @default(uuid())
  author_id                           String
  user_id                             String
  score                               Int
  comment                             String?
  created_at                          DateTime? @default(now())
  users_user_reviews_author_idTousers User      @relation("user_reviews_author_idTousers", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_reviews_user_idTousers   User      @relation("user_reviews_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([author_id, user_id])
  @@index([author_id], map: "idx_user_reviews_author_id")
  @@index([user_id], map: "idx_user_reviews_user_id")
}
